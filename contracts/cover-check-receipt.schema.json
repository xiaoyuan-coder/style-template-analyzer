{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memebuy.local/contracts/cover-check-receipt.schema.json",
  "title": "CoverCheckReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producer", "templateKey", "revision", "verdict", "attempts"],
  "properties": {
    "artifactType": {"const": "cover_check_receipt"},
    "schemaVersion": {"const": "1.0.0"},
    "producer": {"const": "style-template-analyzer"},
    "templateKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$"},
    "revision": {"type": "integer", "minimum": 1},
    "verdict": {"const": "pass"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "verdict", "reasons"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
          "verdict": {"enum": ["pass", "retry"]},
          "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
