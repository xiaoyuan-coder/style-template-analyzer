{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memebuy.local/contracts/style-test-image-assignment-v2.schema.json",
  "title": "StyleTestImageAssignmentV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producer", "deliverySetId", "templateKey", "revision", "assetId", "assignedAt", "status"],
  "properties": {
    "artifactType": {"const": "test_image_assignment"},
    "schemaVersion": {"const": "2.0.0"},
    "producer": {"const": "style-template-analyzer"},
    "deliverySetId": {"type": "string", "minLength": 1},
    "templateKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$"},
    "revision": {"type": "integer", "minimum": 1},
    "assetId": {"type": "string", "minLength": 1},
    "assignedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["reserved", "awaiting_approval", "released", "consumed"]},
    "reviewReadyAt": {"type": "string", "format": "date-time"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "authority", "decidedAt", "reason"],
      "properties": {
        "verdict": {"enum": ["pass", "reject", "manual_release", "system_failure"]},
        "authority": {"enum": ["human", "system"]},
        "decidedAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "coverSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "promptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "reserved"}}},
      "then": {"not": {"anyOf": [{"required": ["reviewReadyAt"]}, {"required": ["decision"]}]}}
    },
    {
      "if": {"properties": {"status": {"const": "awaiting_approval"}}},
      "then": {"required": ["reviewReadyAt"], "not": {"required": ["decision"]}}
    },
    {
      "if": {"properties": {"status": {"const": "consumed"}}},
      "then": {
        "required": ["reviewReadyAt", "decision"],
        "properties": {
          "decision": {
            "properties": {
              "verdict": {"const": "pass"},
              "authority": {"const": "human"}
            },
            "required": ["coverSha256", "promptSha256"]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "released"}}},
      "then": {"required": ["decision"]}
    }
  ]
}
