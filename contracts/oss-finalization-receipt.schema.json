{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memebuy.local/contracts/oss-finalization-receipt.schema.json",
  "title": "OssFinalizationReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactType", "schemaVersion", "producer", "templateKey", "revision", "assetsDomain", "remoteCoverUrl", "provider"],
  "properties": {
    "artifactType": {"const": "oss_finalization_receipt"},
    "schemaVersion": {"const": "1.0.0"},
    "producer": {"const": "style-template-analyzer"},
    "templateKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$"},
    "revision": {"type": "integer", "minimum": 1},
    "assetsDomain": {"type": "string", "minLength": 1},
    "remoteCoverUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
    "provider": {"type": "object"}
  }
}
