{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memebuy.local/schemas/style-analysis.schema.json",
  "title": "WholeImageVisualReconstructionAnalysis",
  "type": "object",
  "required": [
    "schemaVersion",
    "templateKey",
    "referenceAsset",
    "referenceType",
    "extractionMode",
    "referenceContentInventory",
    "transformationContract",
    "renderingFingerprint",
    "signatureMechanisms",
    "referenceContentBlocklist",
    "classificationConfidence",
    "qualityStatus"
  ],
  "properties": {
    "schemaVersion": {"enum": ["2.0", "2.0.0", "3.0.0"]},
    "templateKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$"},
    "referenceAsset": {"type": "string", "minLength": 1, "maxLength": 1000},
    "referenceType": {
      "enum": ["single-style-reference", "paired-images", "paired-comparison", "annotated-paired-comparison"]
    },
    "extractionMode": {
      "enum": ["direct-reconstruction", "paired-difference", "hybrid-operator-salvage", "low-information-salvage"]
    },
    "referenceContentInventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 120},
      "uniqueItems": true
    },
    "transformationContract": {
      "type": "object",
      "required": [
        "families",
        "subjectSelection",
        "subjectForm",
        "poseAndView",
        "instanceMode",
        "environmentMode",
        "compositionMode",
        "contentInvariants",
        "templateConstants",
        "allowedDerivations",
        "textPolicy",
        "framePolicy",
        "renderingTarget"
      ],
      "properties": {
        "families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "enum": ["drawing-style", "material-craft", "subject-form", "visual-system", "information-expression", "composition-structure"]
          },
          "uniqueItems": true
        },
        "subjectSelection": {"enum": ["all-salient", "primary-subject"]},
        "subjectForm": {"enum": ["preserve", "transform"]},
        "poseAndView": {"enum": ["preserve", "derive"]},
        "instanceMode": {"enum": ["preserve", "repeat-or-split"]},
        "environmentMode": {"enum": ["preserve", "simplify", "remove", "replace", "rebuild"]},
        "compositionMode": {"enum": ["preserve", "reorganize"]},
        "contentInvariants": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "enum": ["subject-set", "subject-features", "associated-objects", "key-relationships", "source-frame", "frame-policy"]
          },
          "uniqueItems": true
        },
        "templateConstants": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "minLength": 2, "maxLength": 160},
          "uniqueItems": true
        },
        "allowedDerivations": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "enum": ["local-enlargement", "feature-statistics", "subject-repetition", "new-viewpoint", "new-action", "environment-reconstruction", "composition-reorganization"]
          },
          "uniqueItems": true
        },
        "textPolicy": {
          "type": "object",
          "required": ["subjectText", "environmentText", "templateText"],
          "properties": {
            "subjectText": {"const": "preserve-when-legible"},
            "environmentText": {"enum": ["preserve", "remove-with-environment"]},
            "templateText": {"enum": ["none", "template-specific"]}
          },
          "additionalProperties": false
        },
        "framePolicy": {"enum": ["inherit-source-aspect-ratio", "adaptive-reframe", "fixed-template-aspect-ratio"]},
        "renderingTarget": {"const": "full-non-photographic-redraw"}
      },
      "additionalProperties": false
    },
    "renderingFingerprint": {
      "type": "object",
      "required": ["imagingMedium", "shapeAndDetail", "linesAndEdges", "marksAndTexture", "colorOrganization", "toneAndSpace", "globalCoverage"],
      "properties": {
        "imagingMedium": {"type": "string", "minLength": 5, "maxLength": 500},
        "shapeAndDetail": {"type": "string", "minLength": 5, "maxLength": 500},
        "linesAndEdges": {"type": "string", "minLength": 5, "maxLength": 500},
        "marksAndTexture": {"type": "string", "minLength": 5, "maxLength": 500},
        "colorOrganization": {"type": "string", "minLength": 5, "maxLength": 500},
        "toneAndSpace": {"type": "string", "minLength": 5, "maxLength": 500},
        "globalCoverage": {"type": "string", "minLength": 5, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "signatureMechanisms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["family", "mechanism", "evidence"],
        "properties": {
          "family": {
            "enum": ["drawing-style", "material-craft", "subject-form", "visual-system", "information-expression", "composition-structure", "rendering"]
          },
          "mechanism": {"type": "string", "minLength": 3, "maxLength": 200},
          "evidence": {"type": "string", "minLength": 3, "maxLength": 300}
        },
        "additionalProperties": false
      }
    },
    "referenceContentBlocklist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 120},
      "uniqueItems": true
    },
    "classificationConfidence": {"type": "number", "minimum": 0, "maximum": 1},
    "qualityStatus": {"enum": ["usable", "salvaged", "unusable"]},
    "garmentPrintClassification": {
      "type": "object",
      "required": ["userFacingCategory", "designProduct", "renderingMedium", "subjectTreatment", "visualSystem", "layoutStructure", "printReadiness", "deanalysisRequired"],
      "properties": {
        "userFacingCategory": {"enum": ["手绘", "版印", "漫画", "像素", "材质", "图形", "拼贴", "分镜", "界面"]},
        "designProduct": {"enum": ["artwork", "emblem", "pattern", "panel-sequence", "interface-system", "analysis-board"]},
        "renderingMedium": {"type": "string", "minLength": 2, "maxLength": 80},
        "subjectTreatment": {"enum": ["preserve-form", "stylize-form", "transform-form"]},
        "visualSystem": {"enum": ["none", "decorative-system", "interface-system", "analysis-system"]},
        "layoutStructure": {"enum": ["single-scene", "cutout-subject", "badge-or-sticker", "repeat-pattern", "narrative-panels", "decorative-collage", "ui-windows", "annotated-callouts"]},
        "printReadiness": {"enum": ["A", "B", "C", "D"]},
        "deanalysisRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "salvagePlan": {
      "type": "object",
      "required": ["sourceDependency", "observedOperators", "nonPhotographicCarrier", "coverageExpansion", "uncertainty"],
      "properties": {
        "sourceDependency": {
          "enum": ["partial-photographic", "dominant-photographic", "overlay-dependent", "layout-dependent", "near-empty"]
        },
        "observedOperators": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 3, "maxLength": 240},
          "uniqueItems": true
        },
        "nonPhotographicCarrier": {"type": "string", "minLength": 5, "maxLength": 500},
        "coverageExpansion": {"type": "string", "minLength": 5, "maxLength": 500},
        "uncertainty": {"type": "string", "minLength": 5, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "reviewNotes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"enum": ["2.0", "2.0.0"]}}, "required": ["schemaVersion"]},
      "then": {
        "properties": {
          "transformationContract": {
            "properties": {
              "framePolicy": {"const": "inherit-source-aspect-ratio"},
              "contentInvariants": {"contains": {"const": "source-frame"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"schemaVersion": {"const": "3.0.0"}}, "required": ["schemaVersion"]},
      "then": {
        "properties": {
          "transformationContract": {
            "properties": {
              "contentInvariants": {"contains": {"const": "frame-policy"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"qualityStatus": {"const": "salvaged"}}, "required": ["qualityStatus"]},
      "then": {
        "required": ["salvagePlan"],
        "properties": {"extractionMode": {"enum": ["hybrid-operator-salvage", "low-information-salvage"]}}
      }
    },
    {
      "if": {"properties": {"qualityStatus": {"enum": ["usable", "unusable"]}}, "required": ["qualityStatus"]},
      "then": {"not": {"required": ["salvagePlan"]}}
    }
  ],
  "additionalProperties": false
}
