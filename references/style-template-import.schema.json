{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memebuy.local/schemas/style-template-import.schema.json",
  "title": "StyleReferenceTemplateImport",
  "type": "object",
  "required": [
    "key",
    "title",
    "description",
    "kind",
    "cover",
    "referenceImage",
    "imageSize",
    "imageN",
    "promptTemplate",
    "inputSchema",
    "preprocessSteps",
    "metadata"
  ],
  "properties": {
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 60},
    "description": {"type": "string", "minLength": 1, "maxLength": 240},
    "kind": {"const": "STYLE_REF"},
    "cover": {"type": "string", "minLength": 1, "maxLength": 1000},
    "referenceImage": {"type": "string", "minLength": 1, "maxLength": 1000},
    "imageSize": {"type": "string", "pattern": "^[0-9]{3,4}x[0-9]{3,4}$"},
    "imageN": {"const": 1},
    "promptTemplate": {"type": "string", "minLength": 120, "maxLength": 1200},
    "inputSchema": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "required": ["type", "id", "label", "hint", "required", "maxCount", "private"],
          "properties": {
            "type": {"const": "image"},
            "id": {"const": "source"},
            "label": {"type": "string", "minLength": 1, "maxLength": 40},
            "hint": {"type": "string", "minLength": 1, "maxLength": 100},
            "required": {"const": true},
            "maxCount": {"const": 1},
            "private": {"const": false}
          },
          "additionalProperties": false
        }
      ],
      "items": false
    },
    "preprocessSteps": {"const": []},
    "metadata": {
      "type": "object",
      "required": ["sourceRef"],
      "properties": {
        "tags": {
          "type": "array",
          "maxItems": 10,
          "items": {"type": "string", "minLength": 1, "maxLength": 30},
          "uniqueItems": true
        },
        "styleAnalysis": {
          "type": "object",
          "properties": {
            "surfaceTexture": {"type": "string", "minLength": 1, "maxLength": 500},
            "composition": {"type": "string", "minLength": 1, "maxLength": 500},
            "backgroundPolicy": {"type": "string", "minLength": 1, "maxLength": 500},
            "note": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "additionalProperties": false
        },
        "sourceRef": {
          "type": "object",
          "required": ["producerKey", "styleAsset", "taxonomyVersion"],
          "properties": {
            "producerKey": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,59}$"},
            "styleAsset": {"type": "string", "minLength": 1, "maxLength": 500},
            "taxonomyVersion": {"const": "2.0"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
